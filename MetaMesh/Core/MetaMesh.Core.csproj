<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Meta\TypedModels\Meta.TypedModels.csproj" />
    <ProjectReference Include="..\..\Meta\Surfaces\Meta.Surfaces.csproj" />
    <ProjectReference Include="..\..\Meta\Surfaces.CSharp\Meta.Surfaces.CSharp.csproj" />
    <ProjectReference Include="..\..\Meta\Surfaces.Sql\Meta.Surfaces.Sql.csproj" />
    <ProjectReference Include="..\..\Meta\Core\Meta.Core.csproj" />
    <ProjectReference Include="..\..\Meta\Integration\Meta.Integration.csproj" />
    <ProjectReference Include="..\MetaMesh.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Package\MetaMesh.Core.targets" Pack="true" PackagePath="buildTransitive\MetaMesh.Core.targets" />
    <Content Include="..\Workspace\**\*" Link="MetaMesh\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\net8.0\MetaMesh\%(RecursiveDir)%(Filename)%(Extension)"
             PackageCopyToOutput="true" BuildAction="None" />
  </ItemGroup>

</Project>
