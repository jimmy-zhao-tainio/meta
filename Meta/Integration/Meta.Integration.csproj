<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Meta.Integration</PackageId>
    <Description>Cross-surface import, export, deployment, and service composition for the meta foundation.</Description>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Meta.Core.csproj" />
    <ProjectReference Include="..\Operations\Meta.Operations.csproj" />
    <ProjectReference Include="..\Surfaces\Meta.Surfaces.csproj" />
    <ProjectReference Include="..\Surfaces.Xml\Meta.Surfaces.Xml.csproj" />
    <ProjectReference Include="..\Surfaces.CSharp\Meta.Surfaces.CSharp.csproj" />
    <ProjectReference Include="..\Surfaces.Sql\Meta.Surfaces.Sql.csproj" />
    <ProjectReference Include="..\TypedModels\Meta.TypedModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\PACKAGE-README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
