<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MetaCli.Core</PackageId>
    <Description>Parser, runtime, help, and workspace services for MetaCli applications.</Description>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Meta\Surfaces\Meta.Surfaces.csproj" />
    <ProjectReference Include="..\..\Meta\Operations\Meta.Operations.csproj" />
    <ProjectReference Include="..\..\Meta\Integration\Meta.Integration.csproj" />
    <ProjectReference Include="..\..\Meta\TypedModels\Meta.TypedModels.csproj" />
    <ProjectReference Include="..\MetaCli.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Workspace\**\*" Link="MetaCli\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\net8.0\MetaCli\%(RecursiveDir)%(Filename)%(Extension)"
             PackageCopyToOutput="true" BuildAction="None" />
    <None Include="Package\MetaCli.Core.targets" Pack="true" PackagePath="buildTransitive\MetaCli.Core.targets" />
    <None Include="..\..\PACKAGE-README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
