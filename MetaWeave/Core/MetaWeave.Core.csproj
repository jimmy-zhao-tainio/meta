<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MetaWeave.Core</PackageId>
    <Description>Authors and loads complete MetaWeave correspondences with embedded WeaveScript directions.</Description>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Workspace\**\*" Link="MetaWeave\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\net8.0\MetaWeave\%(RecursiveDir)%(Filename)%(Extension)"
             PackageCopyToOutput="true" BuildAction="None" />
    <ProjectReference Include="..\..\Meta\Integration\Meta.Integration.csproj" />
    <ProjectReference Include="..\MetaWeave.Model.csproj" />
    <ProjectReference Include="..\Script\Execution\MetaWeaveScript.Execution.csproj" />
    <ProjectReference Include="..\Script\Sql\MetaWeaveScript.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Package\MetaWeave.Core.targets" Pack="true" PackagePath="buildTransitive\MetaWeave.Core.targets" />
    <None Include="..\..\PACKAGE-README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
